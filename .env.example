# ==========================================
# CONFIGURACIÓN PARA RAILWAY
# ==========================================
# Railway inyecta automáticamente la variable PORT
# No necesitas configurar PORT aquí

# Database Configuration (Usar tu BD existente)
DB_HOST=tu-host-mysql.railway.app
DB_PORT=3306
DB_NAME=trouvels360_demo
DB_USER=tu-usuario-mysql
DB_PASSWORD=tu-password-mysql

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_RELOAD=False

# CORS Configuration
# Separa múltiples orígenes con coma (sin espacios)
FRONTEND_URL=https://tu-frontend.com
ALLOWED_ORIGINS=https://tu-frontend.com,https://tu-backend-laravel.railway.app

# App Configuration
APP_NAME=Itinerarios Service
APP_VERSION=1.0.0
DEBUG=False

# JWT Configuration
# IMPORTANTE: Debe coincidir con tu backend Laravel
JWT_SECRET=tu-secreto-jwt-aqui-mismo-que-laravel
JWT_ALGORITHM=HS256
JWT_ISSUER=https://tu-backend-laravel.railway.app
JWT_AUDIENCE=fastapi-itinerarios

# Business Rules
HORAS_DISPONIBLES_POR_DIA=8
